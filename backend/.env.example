GOOGLE_API_KEY=
GEMINI_API_KEY=

# DeepSeek configuration
DEEPSEEK_API_KEY=
AGNO_MODEL_PROVIDER=deepseek
AGNO_MODEL=deepseek-v4-flash
AGNO_USE_BROWSER_TOOLS=1
BROWSER_ORIGIN=https://example.com

# Default chat backend: "agno" (native Agent) or "langgraph" (DeepAgents via
# Agno's LangGraphAgent adapter). The panel can still override this per-request.
AGNO_BACKEND=langgraph

# Other providers. Only the key for the provider you actually select is needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# For AGNO_MODEL_PROVIDER=vllm / openai_compatible / custom (any OpenAI-compatible
# server: vLLM, LM Studio, Ollama's OpenAI shim). AGNO_MODEL must then be the name
# the server was started with (vLLM's --served-model-name).
VLLM_BASE_URL=
VLLM_API_KEY=
# OPENAI_BASE_URL=

# Which provider each backend uses. They are separate on purpose: the native
# Agno backend follows AGNO_MODEL_PROVIDER, the LangGraph/DeepAgents backend
# follows AGNO_LANGGRAPH_PROVIDER, so the two can run different models and an
# existing AGNO_MODEL_PROVIDER never silently re-points the DeepAgents harness.
# Valid for both: deepseek | openai | anthropic | gemini | vllm
# Unset AGNO_LANGGRAPH_PROVIDER means deepseek — what the harness always used.
# AGNO_LANGGRAPH_PROVIDER=deepseek
# Model id for the LangGraph backend only; AGNO_MODEL applies otherwise.
# AGNO_LANGGRAPH_MODEL=

# How the selected model expresses thinking vs. answer text (backend/runtime/
# reasoning.py). "auto" (the default) picks the style matching the provider:
# deepseek | openai | anthropic | gemini | plain — set one explicitly only for a
# custom LANGGRAPH_GRAPH whose provider this bridge cannot know.
# AGNO_REASONING_STYLE=auto

# Ask the model for thinking output where the provider requires being asked
# (Anthropic, Gemini, OpenAI reasoning models). Unset = send nothing and take the
# provider's own default, which is all DeepSeek needs. Accepts 1/0 or an
# OpenAI-style effort level: low | medium | high.
# AGNO_THINKING=1
# Thinking token budget, for providers that take one (Anthropic, Gemini). Also
# maps onto OpenAI's effort level when AGNO_THINKING has no explicit level.
# AGNO_THINKING_BUDGET=2048
