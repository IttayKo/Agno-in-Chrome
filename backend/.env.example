GOOGLE_API_KEY=
GEMINI_API_KEY=

# DeepSeek configuration
DEEPSEEK_API_KEY=
AGNO_MODEL_PROVIDER=deepseek
AGNO_MODEL=deepseek-v4-flash
AGNO_USE_BROWSER_TOOLS=1
BROWSER_ORIGIN=https://example.com

# Default chat backend: "agno" (native Agent) or "langgraph" (DeepAgents via
# Agno's LangGraphAgent adapter). The panel can still override this per-request.
AGNO_BACKEND=langgraph
